---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro"

const { id } = Astro.params;

let autor: any = null;
let error: string | null = null;

if (!id || isNaN(Number(id))) {
    return Astro.redirect("/404");
}


try {
    
    const apiUrl = `${Astro.url.origin}/api/authors/${id}`; 
    
    const response = await fetch(apiUrl);
    
    if (response.ok) {
       
        autor = await response.json();
    } else {
        
        const errorData = await response.json();
        
        if (response.status === 404) {
            return Astro.redirect("/404");
        } else {
            console.error(`Error al obtener autor ${id}:`, errorData.error);
            return Astro.redirect("/500");
        }
    }
} catch (e) {
   
    console.error("Error de red/fetch al obtener autor:", e);
    return Astro.redirect("/500");
}


if (!autor) {

    return Astro.redirect("/404");
}

const fechaNacimiento = autor.birthdate 
    ? new Date(autor.birthdate).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })
    : "Fecha desconocida";

const imagenPerfil = autor.imageUrl || "https://via.placeholder.com/300x300?text=Sin+Imagen";



---

<Layout title={autor ? `Perfil de ${autor.name}` : "Autor no encontrado"}>
    <Header />
  <main class="bg-white min-h-screen pb-20">
    
    <div class="bg-[#00305d] py-10 mb-12">
        <div class="max-w-7xl mx-auto px-4 text-center">
            <h1 class="text-4xl font-bold text-white">Perfil del Autor</h1>
            <!--  <p class="text-gray-500 mt-2">Home &gt; {autor.name} {autor.lastName}</p>-->
        </div>
    </div>

    {error ? (
      <div class="max-w-4xl mx-auto p-4 bg-red-100 text-red-700 rounded-lg text-center">
        {error}
      </div>
    ) : (
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="bg-[#EAF4F8] rounded-3xl p-8 md:p-12 flex flex-col md:flex-row items-center gap-15 shadow-sm mb-16">
            
            <div class="relative flex-shrink-0">
                <div class="w-48 h-48 md:w-56 md:h-56 rounded-full p-1 border-1 border-white shadow-lg overflow-hidden bg-white ">
                    <img 
                        src={imagenPerfil} 
                        alt={`Foto de ${autor.name}`} 
                        class="w-full h-full object-cover rounded-full"
                    />
                </div>
            </div>

            <div class="flex-1 text-center md:text-center space-y-4">
                <div>
                    <h2 class="text-3xl md:text-4xl font-bold text-[#00305d] mb-2">
                        {autor.name} {autor.lastName}
                    </h2>
                    <p class="text-lg text-gray-600 font-medium">{autor.nationality}</p>
                </div>

                <div class="flex flex-wrap justify-center md:justify-center gap-3 mt-4">
                    <span class="px-4 py-1 bg-white text-[#00305d] border border-blue-100 rounded-full text-sm font-semibold shadow-sm">
                        {autor.genre}
                    </span>
                    <span class="px-4 py-1 bg-white text-gray-600 border border-gray-200 rounded-full text-sm font-semibold shadow-sm">
                        Nacimiento: {fechaNacimiento}
                    </span>
                </div>
            </div>

            <div class="flex-shrink-0 border-t md:border-t-0 md:border-l border-gray-300 pt-6 md:pt-0 md:pl-10 text-center">
                <div class="flex flex-col items-center">
                    <span class="text-5xl font-bold text-[#00305d]">{autor._count.books}</span>
                    <span class="text-gray-600 font-medium mt-1">Libros Publicados</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-3 lg:grid-cols-3 gap-12">
            <div class="lg:col-span-3 col-span-3">
                <h3 class="text-2xl font-bold text-[#00305d] mb-6 border-l-4 border-[#01ada4] pl-4">
                    Biografía
                </h3>
                <div class="prose prose-lg text-gray-600 leading-relaxed text-justify whitespace-pre-line">
                    
                    {autor.biography}
                </div>
            </div>

            
        </div>

      </div>
    )}
  </main>
  <Footer />
</Layout>