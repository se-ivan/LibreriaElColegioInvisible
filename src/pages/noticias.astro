---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import NewsCard from "../components/NewsCard.astro";
import Footer from "../components/Footer.astro";

const STRAPI_ADMIN_URL = import.meta.env.PUBLIC_STRAPI_ADMIN_NOTICIAS_URL;
const STRAPI_URL = import.meta.env.PUBLIC_STRAPI_API_URL;
const COLLECTION_ENDPOINT = `${STRAPI_URL}/api/noticas`;

const apiEndpoint = `${COLLECTION_ENDPOINT}?populate=imageUrl`;

interface NoticiaProps {
    id: number;
    title: string;
    pretitle: string;
    date: string;
    image: string;
}

let noticias: NoticiaProps[] = [];

try {
    const response = await fetch(apiEndpoint);

    if (!response.ok) {
        throw new Error(`Error al obtener datos de Strapi: ${response.status}`);
    }

    const result = await response.json();

    noticias = result.data.map((item: any) => {
        const imageObject = item.imageUrl;

        let imageUrlFinal = "";
        if (imageObject && imageObject.url) {
            imageUrlFinal = imageObject.url;
        } else if (
            imageObject &&
            imageObject.formats &&
            imageObject.formats.small
        ) {
            imageUrlFinal = imageObject.formats.small.url;
        }

        const dateString = item.publishedAt || item.date;

        let formattedDate = "Fecha no disponible";

        if (dateString) {
            const rawDate = new Date(dateString);

            if (!isNaN(rawDate.getTime())) {
                formattedDate = rawDate.toLocaleDateString("es-ES", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                });
            }
        }

        return {
            id: item.documentId,
            title: item.title || "Título sin especificar",
            pretitle: item.pretitle || "",
            date: formattedDate,
            image: imageUrlFinal,
        };
    });
} catch (error) {
    console.error("Error al cargar noticias de Strapi:", error);
    noticias = [];
}

const isAdmin = true;
---

<Layout title="Noticias">
    <Header />
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <section class="relativepy-6 text-white text-center w-full mb-15">
            {isAdmin && (
                <a 
                    href={STRAPI_ADMIN_URL} 
                    target="_blank"
                    class="absolute right-0 top-0 mt-8 md:mt-0 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-[#01ada4] hover:bg-emerald-500 transition">

                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zm-7.57 7.07l5.656-5.656 2.828 2.828-5.656 5.656a1 1 0 01-.392.242l-2.735.684a.5.5 0 01-.626-.626l.684-2.735a1 1 0 01.242-.392z" />
                    </svg>
                    Editar Noticias (Strapi)
                </a>
            )}
            
            {/* Contenido del Encabezado */}
            <h1 class="text-5xl text-slate-900 font-bold">Noticias</h1>
            <p class="text-slate-600 mt-2">
                Mantente al día con las últimas novedades.
            </p>
        </section>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                noticias.length > 0 ? (
                    noticias.map((noticia) => (
                        <NewsCard
                            id={noticia.id}
                            title={noticia.title}
                            pretitle={noticia.pretitle}
                            date={noticia.date}
                            image={noticia.image}
                        />
                    ))
                ) : (
                    <div class="col-span-full text-center py-20 bg-gray-50 rounded-lg">
                        <p class="text-xl text-gray-500">
                            No se pudieron cargar noticias o no hay contenido
                            disponible.
                        </p>
                        <p class="text-sm text-gray-400 mt-2">
                            Verifica que tu servidor Strapi esté corriendo en
                            Render y que los permisos 'Public' estén habilitados
                            para la colección 'noticia'.
                        </p>
                    </div>
                )
            }
        </div>
    </main>
    <Footer />
</Layout>
