---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { actions } from 'astro:actions';
import prisma from "../../lib/prisma";
import BookComments from "../../components/BookComments";
import AddCommentForm from "../../components/AddCommentForm";

const { id } = Astro.params;
if (!id || isNaN(Number(id))) {
    return Astro.redirect('/404');
}
const result = await Astro.callAction(actions.getBook, { 
    id: Number(id) 
});

if (result.error || !result.data) {
    console.error("Error cargando libro:", result.error);
    return Astro.redirect('/404');
}
const dbUser = await prisma.user.findFirst();
const currentUser = dbUser ? { 
    id: dbUser.id, 
    name: dbUser.name || "Usuario Registrado", 
    image: dbUser.image || null 
} : null; 
const book = result.data.book as any;
const relatedBooks = (result.data.relatedBooks || []) as any[];

const imageSrc = book.coverImage || "/logoColegio.jpg";
const fullStars = Math.floor(book.rating || 0); 
const emptyStars = 5 - fullStars;
const genre = book.genre || "General";
const price = Number(book.price).toFixed(2);
const description = book.description || "Sin descripción disponible para este libro.";

const highlights = [
    "Envío gratis en pedidos superiores a $50",
    "Devolución garantizada por 30 días",
    "Disponible para retiro en tienda"
];

const specs = {
    isbn: book.isbn || "N/A",
    editorial: book.editorial || "N/A",
    pages: 350, 
    year: book.publicationYear || 2024,
    language: "Español"
};
---

<Layout title={`${book.title} | Librería`}>
    <Header />

    <main class="bg-gray-50 min-h-screen py-8">
        <div class="container mx-auto px-4">
            
            <nav class="text-sm text-gray-500 mb-8">
                <a href="/BookList" class="hover:text-blue-700">Libros</a>
                <span class="mx-2">/</span>
                <span class="text-gray-900 font-medium">{book.title}</span>
            </nav>

            <div class="bg-white rounded-xl shadow-sm p-6 md:p-10">
                <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
                    
                    <div class="md:col-span-4 lg:col-span-3 flex flex-col gap-6">
                        <div class="relative rounded-lg overflow-hidden shadow-lg border border-gray-100">
                            <img
                                src={imageSrc}
                                alt={`Portada de ${book.title}`}
                                class="w-full h-auto object-cover"
                            />
                        </div>

                        <div class="flex flex-col gap-3">
                            <button class="w-full bg-blue-700 hover:bg-blue-800 text-white font-bold py-3 px-4 rounded-lg shadow transition-colors flex items-center justify-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                </svg>
                                Agregar al Carrito - ${price}
                            </button>

                            <div class="grid grid-cols-2 gap-3">
                                <button class="flex items-center justify-center gap-2 border border-gray-300 text-gray-700 py-2 rounded-lg hover:bg-gray-50 transition">
                                    <span class="text-xl">♡</span> Favoritos
                                </button>
                                <button class="flex items-center justify-center gap-2 border border-gray-300 text-gray-700 py-2 rounded-lg hover:bg-gray-50 transition">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                                    </svg> Compartir
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="md:col-span-8 lg:col-span-9">
                        <div class="flex justify-between items-start">
                            <div>
                                <h1 class="text-3xl md:text-4xl font-bold text-slate-900 mb-2">
                                    {book.title}
                                </h1>
                                <p class="text-xl text-slate-600 mb-4">
                                    por <span class="font-medium text-blue-700">
                                        {book.author?.name} {book.author?.lastName}
                                    </span>
                                </p>
                            </div>
                            <span class="bg-blue-100 text-blue-800 text-sm font-medium px-3 py-1 rounded-full">
                                {genre}
                            </span>
                        </div>

                        <div class="flex items-center gap-4 mb-6 text-sm">
                            <div class="flex items-center text-yellow-400">
                                {Array(fullStars).fill(null).map(() => <span>★</span>)}
                                {Array(emptyStars).fill(null).map(() => <span class="text-gray-300">★</span>)}
                            </div>
                            <span class="ml-2 text-slate-600 font-medium text-base">{book.rating || 0}</span>
                            <div class="h-4 w-px bg-gray-300"></div>
                            <span class="flex items-center text-green-600 font-medium gap-1">
                                <span class="text-lg">•</span> En stock
                            </span>
                        </div>

                        <hr class="border-gray-100 mb-6" />

                        <div class="mb-8">
                            <h3 class="text-lg font-bold text-slate-900 mb-3">Descripción</h3>
                            <p class="text-slate-600 leading-relaxed">
                                {description}
                            </p>
                        </div>

                        <div class="mb-8">
                            <h3 class="text-lg font-bold text-slate-900 mb-3">Características Destacadas</h3>
                            <ul class="list-disc list-inside text-slate-600 space-y-1">
                                {highlights.map((item) => (
                                    <li>{item}</li>
                                ))}
                            </ul>
                        </div>

                        <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-y-6 gap-x-4 text-sm">
                                <div>
                                    <p class="text-gray-400 mb-1">ISBN</p>
                                    <p class="font-medium text-slate-900">{specs.isbn}</p>
                                </div>
                                <div>
                                    <p class="text-gray-400 mb-1">Editorial</p>
                                    <p class="font-medium text-slate-900">{specs.editorial}</p>
                                </div>
                                <div>
                                    <p class="text-gray-400 mb-1">Idioma</p>
                                    <p class="font-medium text-slate-900">{specs.language}</p>
                                </div>
                                <div>
                                    <p class="text-gray-400 mb-1">Páginas</p>
                                    <p class="font-medium text-slate-900">{specs.pages}</p>
                                </div>
                                <div>
                                    <p class="text-gray-400 mb-1">Año</p>
                                    <p class="font-medium text-slate-900">{specs.year}</p>
                                </div>
                                <div class="col-span-2">
                                    <p class="text-gray-400 mb-1">Disponibilidad</p>
                                    <p class="font-medium text-blue-600 flex items-center gap-1">
                                        <span class="text-xs">📍</span> Ambas sucursales
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-16 pt-10 border-t border-gray-100">
                    <h2 class="text-2xl font-bold text-slate-900 mb-6">Reseñas de Clientes</h2>
                    <AddCommentForm client:visible bookId={book.id} user={currentUser} />
                    <BookComments client:visible bookId={String(book.id)} />
                </div>

                {relatedBooks.length > 0 && (
                    <div class="mt-16 pt-10 border-t border-gray-100">
                        <h2 class="text-2xl font-bold text-slate-900 mb-6">Libros Relacionados</h2>
                        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
                            {relatedBooks.map((related: any) => {
                                const rImage = related.coverImage || related.imageSrc || "/logoColegio.jpg";
                                return (
                                    <a href={`/books/${related.id}`} class="group block bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                                        <div class="relative aspect-[2/3] overflow-hidden bg-gray-100">
                                            <img
                                                src={rImage}
                                                alt={related.title}
                                                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                                            />
                                        </div>
                                        <div class="p-4">
                                            <h3 class="font-bold text-slate-900 truncate text-lg mb-1 group-hover:text-blue-700 transition-colors">
                                                {related.title}
                                            </h3>
                                            <p class="text-sm text-gray-500 mb-3">
                                                {related.author ? `${related.author.name} ${related.author.lastName}` : "Autor"}
                                            </p>
                                            <p class="font-bold text-blue-700 text-lg">
                                                ${Number(related.price).toFixed(2)}
                                            </p>
                                        </div>
                                    </a>
                                );
                            })}
                        </div>
                    </div>
                )}

            </div>
        </div>
    </main>
    <Footer />
</Layout>