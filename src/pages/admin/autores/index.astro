---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { actions } from 'astro:actions'; 

const AUTORES_ENDPOINT = '/api/admin/authors/autores'; 
const deleteAuthorAction = actions.authorActions.delete; 

interface AuthorsApiResponse {
    authors: Author[];
    total: number;
    currentPage: number;
    limit: number;
    totalPages: number;
}

interface Author {
    id: number; 
    name: string;
    lastName: string;
    biography: string;
    [key: string]: any; 
}
// --------------------

let autores: Author[] = [];
let error: string | null = null;

try {
    const res = await fetch(Astro.url.origin + AUTORES_ENDPOINT);
    if (res.ok) {
        const apiResponse: AuthorsApiResponse = await res.json();
        autores = apiResponse.authors || [];
    } else {
        error = `Error ${res.status} al cargar autores.`;
        console.error(error);
    }
} catch (e) {
    error = 'Error de conexión al obtener la lista de autores.';
    console.error(e);
}
---

<AdminLayout title="Administrar Autores">
    <div class="flex justify-between items-center mb-6">
        <h1 class="text-3xl font-bold text-slate-800">Gestión de Autores ({autores.length})</h1>
        <a href="/admin/autores/crear" class="bg-[#01ada4] hover:bg-emerald-500 text-white font-bold py-2 px-4 rounded transition shadow">
            + Crear Nuevo Autor
        </a>
    </div>

    {error && (
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" role="alert">
            <p class="font-bold">Error:</p>
            <p class="text-sm">{error}</p>
        </div>
    )}

    <div class="bg-white p-6 rounded-lg shadow-xl overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
            <thead>
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nombre Completo</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Biografía (Extracto)</th>
                    <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                {autores.length === 0 ? (
                    <tr>
                        <td colspan="4" class="px-6 py-4 text-center text-gray-500">No hay autores registrados.</td>
                    </tr>
                ) : (
                    autores.map((autor) => (
                        <tr data-autor-id={autor.id}>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{autor.id}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                                {autor.name} {autor.lastName}
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-500">
                                {autor.biography.substring(0, 50)}...
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                                <a href={`/admin/autores/editar/${autor.id}`} class="text-indigo-600 hover:text-indigo-900">Editar</a>
                                
                                <button 
                                    class="text-red-600 hover:text-red-900 delete-button"
                                    data-autor-id={autor.id}
                                    data-autor-name={`${autor.name} ${autor.lastName}`}
                                >
                                    Eliminar
                                </button>
                                </td>
                        </tr>
                    ))
                )}
            </tbody>
        </table>
    </div>
</AdminLayout>

<script>
    import { actions } from 'astro:actions';

    // 🚨 Definimos la Action de eliminación en el cliente
    const deleteAction = actions.authorActions.delete;

    document.addEventListener('DOMContentLoaded', () => {
        const deleteButtons = document.querySelectorAll('.delete-button');

        deleteButtons.forEach(button => {
            button.addEventListener('click', async (event) => {
                const button = event.currentTarget as HTMLButtonElement;
                const id = parseInt(button.dataset.autorId || '0', 10);
                const name = button.dataset.autorName;

                if (id === 0) {
                    alert("Error: ID de autor no encontrado.");
                    return;
                }

                // Confirmación del usuario
                if (!confirm(`¿Estás seguro de que quieres eliminar al autor ${name} (ID: ${id})? Esta acción es irreversible.`)) {
                    return;
                }

                try {
                    // Llamamos a la Action DELETE con el ID
                    const result = await deleteAction({ id: id });

                    // 🚨 CAMBIOS AQUÍ: Verifica si result.data existe y luego accede a result.data.success
                    if (result.data?.success) { // <--- CORRECCIÓN CLAVE
                        alert(`Autor ${name} eliminado correctamente.`);
                        // Recargar la página para actualizar la lista
                        window.location.reload(); 
                    } else if (result.error) {
                        // result.error existe si la acción lanzó un error (throw new Error("..."))
                        alert(`Error al eliminar: ${result.error.message}`);
                    } else {
                        // Esto captura casos inesperados donde 'data' no tiene 'success' (aunque debería tenerlo)
                        alert("Ocurrió un error desconocido durante la operación.");
                    }
                } catch (e) {
                    console.error("Error al llamar a la action:", e);
                    alert("Ocurrió un error inesperado al eliminar el autor.");
                }
            });
        });
    });
</script>