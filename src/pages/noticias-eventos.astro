---
import NewsCard from "../components/NewsCard.astro";
import EventCard from "../components/EventCard.astro";
import EventFilter from "../components/EventFilter.astro";
import prisma from "../lib/prisma";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro"

const news = await prisma.new.findMany({
  orderBy: { date: "desc" },
});
---
<Layout title="Noticias y eventos">
     <Header />
    <section class="bg-[#002B5B] py-12 text-white text-center">
        <h1 class="text-4xl text-white font-bold">Noticias y Eventos</h1>
        <p class="text-gray-200 mt-2">Mantente al día con las últimas novedades.</p>
    </section>


  <div class="flex justify-center mt-10 mb-6">
    <EventFilter currentCategory="todos" />
  </div>

   <div class="px-4 mb-10">
    <EventCard />
  </div>

  <section class="max-w-6xl mx-auto px-4 py-12">

    {news.length === 0 && (
      <p class="mt-10 text-center text-gray-500">No hay noticias disponibles.</p>
    )}

    <div class="grid gap-8 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 mt-6">
      {news.map(item => (
        <NewsCard
          id={item.id}
          title={item.title}
          pretitle={item.pretitle ?? ""}
          date={new Date(item.date).toLocaleDateString("es-MX")}
          image={item.imageUrl}
        />
      ))}
    </div>

  </section>
  <Footer />
</Layout>

