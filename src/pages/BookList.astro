---
import Layout from "../layouts/Layout.astro";
import prisma from "../lib/prisma";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

const pageSize = 8;
const currentPage = Number(Astro.url.searchParams.get("page") || 1);
const skip = (currentPage - 1) * pageSize;

let books: any[] = [];
let totalBooks = 0;

try {
    books = (await prisma.book.findMany({
        include: {
            author: true,
        },
        skip: skip,
        take: pageSize,
    })) as any[];
    totalBooks = await prisma.book.count();
} catch (error) {
    console.error("Error al obtener libros de la base de datos:", error);
}

let totalPages = Math.ceil(totalBooks / pageSize);

/*if (books.length === 0 && totalBooks === 0) {
  books.push({
    id: 999,
    title: "Libro de Ejemplo (Mock)",
    price: 29.99,
    author: { id: 1, name: "Autor", lastName: "Prueba" }, 
  });
  totalPages = 1; 
}*/

if (totalBooks === 0) {
    const mockBooks = [
        {
            id: 1,
            title: "El Rithmatista",
            price: 18.99,
            author: { name: "Brandon", lastName: "Sanderson" },
        },
        {
            id: 2,
            title: "El Camino de los Reyes",
            price: 32.5,
            author: { name: "Brandon", lastName: "Sanderson" },
        },
        {
            id: 3,
            title: "El Héroe de las Eras",
            price: 22.99,
            author: { name: "Brandon", lastName: "Sanderson" },
        },
        {
            id: 4,
            title: "Elantris",
            price: 20.0,
            author: { name: "Brandon", lastName: "Sanderson" },
        },
        {
            id: 5,
            title: "Palabras Radiantes",
            price: 34.0,
            author: { name: "Brandon", lastName: "Sanderson" },
        },
        {
            id: 6,
            title: "Juramentada",
            price: 35.0,
            author: { name: "Brandon", lastName: "Sanderson" },
        },
        {
            id: 7,
            title: "Aleación de Ley",
            price: 17.99,
            author: { name: "Brandon", lastName: "Sanderson" },
        },
        {
            id: 8,
            title: "Sombras de Identidad",
            price: 18.99,
            author: { name: "Brandon", lastName: "Sanderson" },
        },
        {
            id: 9,
            title: "Brazales de Duelo",
            price: 19.99,
            author: { name: "Brandon", lastName: "Sanderson" },
        },
        {
            id: 10,
            title: "El Ritmo de la Guerra",
            price: 36.0,
            author: { name: "Brandon", lastName: "Sanderson" },
        },
    ];
    totalBooks = mockBooks.length;
    totalPages = Math.ceil(totalBooks / pageSize);
    books = mockBooks.slice(skip, skip + pageSize);
}

const pageTitle = "Catálogo de Libros";
---

<Layout title={pageTitle}>
    <Header />
    <main>
        <div class="container mx-auto px-4 py-12">
            <div class="text-center mb-12">
                <h1 class="text-4xl font-extrabold text-slate-900 mb-2">
                    {pageTitle}
                </h1>
                <p class="text-lg text-slate-600">
                    Explora nuestra colección de historias que te transportarán
                    a mundos extraordinarios
                </p>
            </div>
            <div class="bg-white p-6 rounded-lg shadow-sm mb-8">
                <div
                    class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4 items-end"
                >
                    <div class="lg:col-span-2">
                        <label
                            for="search"
                            class="block text-sm font-medium text-gray-700 mb-1"
                            >Buscar</label
                        >
                        <input
                            type="text"
                            id="search"
                            placeholder="Busca por título o autor"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500"
                        />
                    </div>
                    <div>
                        <label
                            for="genero"
                            class="block text-sm font-medium text-gray-700 mb-1"
                            >Géneros</label
                        >
                        <select
                            id="genero"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500"
                        >
                            <option>Todos los géneros</option>
                        </select>
                    </div>
                    <div>
                        <label
                            for="subgenero"
                            class="block text-sm font-medium text-gray-700 mb-1"
                            >Sucursales</label
                        >
                        <select
                            id="subgenero"
                            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500"
                        >
                            <option>Todas las sucursales</option>
                        </select>
                    </div>
                </div>
                <div class="mt-4 flex items-center gap-6 text-sm">
                    <a
                        href="#"
                        class="font-semibold text-teal-600 border-b-2 border-teal-600 pb-1"
                        >Más vendidos</a
                    >
                    <a href="#" class="text-gray-500 hover:text-teal-600"
                        >Más nuevos</a
                    >
                    <a href="#" class="text-gray-500 hover:text-teal-600"
                        >De Oferta</a
                    >
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                {
                    books.map((book) => {
                        const mock = {
                            imageSrc: "/logoColegio.jpg",
                            rating: 4.8,
                            genre: "Fantasía",
                            stockStatus: "En stock - Sucursal A",
                        };
                        const fullStars = Math.floor(mock.rating);
                        const emptyStars = 5 - fullStars;
                        return (
                            <div class="bg-white rounded-lg shadow-md overflow-hidden transition-shadow duration-300 hover:shadow-xl flex flex-col">
                                {" "}
                                <img
                                    src={mock.imageSrc}
                                    alt={`Portada de ${book.title}`}
                                    class="w-full h-64 object-cover"
                                />{" "}
                                <div class="p-4 flex-grow flex flex-col">
                                    {" "}
                                    <h3 class="text-lg font-semibold text-gray-900 mb-1 truncate">
                                        {book.title}
                                    </h3>{" "}
                                    <p class="text-sm text-gray-600 mb-2">
                                        {book.author.name}{" "}
                                        {book.author.lastName}
                                    </p>{" "}
                                    <div class="flex items-center mb-1">
                                        {" "}
                                        {Array(fullStars)
                                            .fill(null)
                                            .map(() => (
                                                <span class="text-yellow-400">
                                                    ★
                                                </span>
                                            ))}{" "}
                                        {Array(emptyStars)
                                            .fill(null)
                                            .map(() => (
                                                <span class="text-gray-300">
                                                    ★
                                                </span>
                                            ))}{" "}
                                        <span class="text-xs text-gray-500 ml-2">
                                            ({mock.rating.toFixed(1)})
                                        </span>{" "}
                                    </div>{" "}
                                    <div class="flex flex-wrap gap-2 mb-2">
                                        {" "}
                                        <span class="text-xs font-medium bg-gray-100 text-gray-700 px-2.5 py-0.5 rounded-full">
                                            {mock.genre}{" "}
                                        </span>{" "}
                                    </div>{" "}
                                    <p class="text-sm text-gray-500 mb-4">
                                        {mock.stockStatus}
                                    </p>{" "}
                                    <div class="mt-auto flex justify-between items-center">
                                        {" "}
                                        <span class="text-2xl font-bold text-gray-900">
                                            $
                                            {Number(book.price || 0).toFixed(2)}
                                        </span>{" "}
                                        <button class="bg-teal-500 text-white font-semibold px-5 py-2 rounded-lg transition-colors duration-200 hover:bg-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-400 focus:ring-opacity-75">
                                            Agregar{" "}
                                        </button>{" "}
                                    </div>{" "}
                                </div>{" "}
                            </div>
                        );
                    })
                }
            </div>

            <nav class="flex justify-center mt-12">
                <ul class="flex items-center gap-2">
                    {
                        currentPage > 1 && (
                            <li>
                                {" "}
                                <a
                                    href={`${Astro.url.pathname}?page=${currentPage - 1}`}
                                    class="inline-flex items-center justify-center px-4 h-10 leading-tight text-gray-500 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 hover:text-gray-700"
                                >
                                    Anterior
                                </a>{" "}
                            </li>
                        )
                    }

                    {
                        Array.from({ length: totalPages }, (_, i) => i + 1).map(
                            (pageNumber) => (
                                <li>
                                    {" "}
                                    <a
                                        href={`${Astro.url.pathname}?page=${pageNumber}`}
                                        aria-current={
                                            pageNumber === currentPage
                                                ? "page"
                                                : false
                                        }
                                        class:list={[
                                            "inline-flex items-center justify-center px-4 h-10 rounded-lg",
                                            pageNumber === currentPage
                                                ? "text-white bg-teal-500 border border-teal-500 hover:bg-teal-600"
                                                : "text-gray-700 bg-white border border-gray-300 hover:bg-gray-100 hover:text-teal-600",
                                        ]}
                                    >
                                        {pageNumber}{" "}
                                    </a>{" "}
                                </li>
                            ),
                        )
                    }

                    {
                        currentPage < totalPages && (
                            <li>
                                {" "}
                                <a
                                    href={`${Astro.url.pathname}?page=${currentPage + 1}`}
                                    class="inline-flex items-center justify-center px-4 h-10 leading-tight text-gray-500 bg-white border border-gray-300 rounded-lg hover:bg-gray-100 hover:text-gray-700"
                                >
                                    Siguiente
                                </a>{" "}
                            </li>
                        )
                    }
                </ul>
            </nav>
        </div>
    </main>
    <Footer />
</Layout>
