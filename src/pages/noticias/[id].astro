---
import Layout from "../../layouts/Layout.astro";
import prisma from "../../lib/prisma";

const { id } = Astro.params;
const numericId = Number(id);


const noticia = await prisma.new.findUnique({
  where: { id: numericId },
});
console.log("🧩 NOTICIA COMPLETA:", noticia);
if (!noticia) {
  return Astro.redirect("/noticias-eventos");
}

const imagePath = noticia.imageUrl
  ? noticia.imageUrl.startsWith('/')
    ? noticia.imageUrl
    : `/${noticia.imageUrl}`
  : null;
---

<Layout title={noticia.title}>
  <section class="bg-[#002B5B] text-white py-16">
    <div class="container mx-auto max-w-4xl px-6">

      <a href="/noticias-eventos" class="text-cyan-400 text-sm hover:underline">
        ← Regresar
      </a>

      <h1 class="text-4xl font-bold mt-4 mb-2">{noticia.title}</h1>

      {noticia.pretitle && (
        <p class="text-gray-300 mb-6 text-lg">{noticia.pretitle}</p>
      )}

      {imagePath && (
        <img src={imagePath} alt={noticia.title} class="w-full h-80 object-cover rounded-lg mb-8" />
      )}

     <article class="prose prose-invert max-w-none leading-relaxed whitespace-pre-wrap">
    {noticia.description || "Sin descripción disponible."}
    </article>

      
    </div>
  </section>
</Layout>
