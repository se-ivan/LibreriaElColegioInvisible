---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import EventCard from "../components/EventCard.astro";
import Footer from "../components/Footer.astro";

const STRAPI_URL = import.meta.env.PUBLIC_STRAPI_API_URL;
const COLLECTION_ENDPOINT = `${STRAPI_URL}/api/eventos`;

const apiEndpoint = `${COLLECTION_ENDPOINT}?populate=imageUrl`;

interface EventoProps {
    id: number;
    title: string;
    description: string;
    date: string;
    location: string;
    price: number;
    image: string;
    category?: string;
    duration?: string;
    buttonText?: string;
    registrationUrl?: string;
}

let eventos: EventoProps[] = [];

try {
    const response = await fetch(apiEndpoint);

    if (!response.ok) {
        throw new Error(`Error al obtener datos de Strapi: ${response.status}`);
    }

    const result = await response.json();

    eventos = result.data.map((item: any) => {
        const imageObject = item.imageUrl;

        let imageUrlFinal = "";
        if (imageObject && imageObject.url) {
            imageUrlFinal = imageObject.url;
        } else if (
            imageObject &&
            imageObject.formats &&
            imageObject.formats.small
        ) {
            imageUrlFinal = imageObject.formats.small.url;
        }

        const dateString = item.date;
        let formattedDate = "Fecha por confirmar";

        if (dateString) {
            const rawDate = new Date(dateString);

            if (!isNaN(rawDate.getTime())) {
                formattedDate = rawDate.toLocaleDateString("es-ES", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                    hour: "2-digit",
                    minute: "2-digit",
                });
            }
        }

        // Extract plain text from description rich text if possible, or just use a fallback
        let descriptionText = "";
        if (Array.isArray(item.description)) {
            item.description.forEach((block: any) => {
                if (block.children) {
                    block.children.forEach((child: any) => {
                        if (child.text) descriptionText += child.text + " ";
                    });
                }
            });
        } else {
            descriptionText = item.description || "Sin descripción";
        }

        return {
            id: item.documentId,
            title: item.title || "Evento sin título",
            description:
                descriptionText.substring(0, 100) +
                (descriptionText.length > 100 ? "..." : ""),
            date: formattedDate,
            location: item.location || "Ubicación por confirmar",
            price: item.price !== undefined ? Number(item.price) : 0,
            image: imageUrlFinal,
            category: item.category || "Evento",
            duration: item.duration,
            buttonText: item.buttonText,
            registrationUrl: item.registrationUrl,
        };
    });
} catch (error) {
    console.error("Error al cargar eventos de Strapi:", error);
    eventos = [];
}

const categories = [
    "Todos",
    "Firma de Libros",
    "Club de Lectura",
    "Taller",
    "Infantil",
];
---

<Layout title="Eventos | El Colegio Invisible">
    <Header />
    <main class="bg-gray-50 min-h-screen">
        <!-- Hero Section -->
        <section class="bg-[#00305d] text-white py-16 px-4 text-center">
            <h1 class="text-4xl md:text-5xl font-bold mb-4 font-geist">
                Próximos Eventos
            </h1>
            <p class="text-lg text-gray-300 max-w-2xl mx-auto">
                Participa en nuestras actividades culturales, talleres y
                encuentros con autores.
            </p>
        </section>

        <!-- Filter Section -->
        <div class="flex justify-center -mt-8 mb-12 relative z-10 px-4">
            <div
                class="bg-white p-2 rounded-full shadow-lg flex flex-wrap justify-center gap-2"
            >
                {
                    categories.map((cat) => (
                        <button
                            class="px-6 py-2 rounded-full text-sm font-medium transition-colors hover:bg-teal-50 hover:text-teal-700 focus:outline-none focus:ring-2 focus:ring-teal-500 focus:ring-offset-2 category-filter"
                            data-category={cat}
                        >
                            {cat}
                        </button>
                    ))
                }
            </div>
        </div>

        <!-- Events List -->
        <section class="max-w-6xl mx-auto px-4 pb-20 space-y-8">
            {
                eventos.length > 0 ? (
                    eventos.map((evento) => (
                        <div class="event-item" data-category={evento.category}>
                            <EventCard
                                title={evento.title}
                                description={evento.description}
                                date={evento.date}
                                location={evento.location}
                                price={evento.price}
                                image={evento.image}
                                category={evento.category}
                                duration={evento.duration}
                                buttonText={evento.buttonText}
                                registrationUrl={evento.registrationUrl}
                            />
                        </div>
                    ))
                ) : (
                    <div id="no-events-api" class="text-center py-12">
                        <p class="text-gray-500 text-lg">
                            No hay eventos programados próximamente.
                        </p>
                    </div>
                )
            }

            <div id="no-events-filter" class="hidden text-center py-12">
                <p class="text-gray-500 text-lg">
                    No hay eventos en esta categoría por el momento.
                </p>
            </div>
        </section>
    </main>
    <Footer />
</Layout>

<script>
    const filterButtons = document.querySelectorAll(".category-filter");
    const eventItems = document.querySelectorAll(".event-item");
    const noEventsMsg = document.getElementById("no-events-filter");

    if (filterButtons.length > 0) {
        // Set initial active state
        filterButtons[0].classList.add("bg-teal-500", "text-white");
        filterButtons[0].classList.remove(
            "hover:bg-teal-50",
            "hover:text-teal-700",
        );

        filterButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                // Update active state
                filterButtons.forEach((b) => {
                    b.classList.remove("bg-teal-500", "text-white");
                    b.classList.add("hover:bg-teal-50", "hover:text-teal-700");
                });
                btn.classList.add("bg-teal-500", "text-white");
                btn.classList.remove("hover:bg-teal-50", "hover:text-teal-700");

                const selectedCategory = (btn as HTMLElement).dataset.category;
                let visibleCount = 0;

                eventItems.forEach((item) => {
                    const itemCategory = (item as HTMLElement).dataset.category;
                    if (
                        selectedCategory === "Todos" ||
                        itemCategory === selectedCategory
                    ) {
                        (item as HTMLElement).style.display = "block";
                        visibleCount++;
                    } else {
                        (item as HTMLElement).style.display = "none";
                    }
                });

                if (visibleCount === 0) {
                    noEventsMsg?.classList.remove("hidden");
                } else {
                    noEventsMsg?.classList.add("hidden");
                }
            });
        });
    }
</script>
