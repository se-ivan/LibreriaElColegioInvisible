---
import { SignIn } from "auth-astro/components";

const response = await fetch(`${Astro.url.origin}/api/auth/csrf`);
const { csrfToken } = await response.json();

import "../styles/global.css";

const error = Astro.url.searchParams.get("error");
---

<div
  class="min-h-screen bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center p-4"
>
  <div
    class="w-full max-w-5xl flex flex-col md:flex-row rounded-2xl shadow-2xl overflow-hidden bg-white"
  >
    <!-- Left Panel - Branding -->
    <div
      class="w-full md:w-1/2 aspect-square flex flex-col items-center rounded-l-xl justify-center p-12 bg-[#281E67] text-white text-center relative overflow-hidden"
    >
      <img
        src="/logoColegio.jpg"
        alt="Logo"
        class="aspect-square w-full max-h-[415px]"
      />
    </div>

    <!-- Right Panel - Form -->
    <div class="w-full md:w-1/2 bg-white p-8 md:p-12">
      <!-- Tab Navigation -->
      <div class="flex mb-8 gap-4">
        <button
          id="show-login-btn"
          class="flex-1 py-3 text-sm font-medium text-center rounded-full transition-all duration-200 border border-transparent hover:bg-gray-50"
        >
          Iniciar sesión
        </button>
        <button
          id="show-register-btn"
          class="flex-1 py-3 text-sm font-medium text-center rounded-full bg-black text-white transition-all duration-200 hover:bg-gray-800"
        >
          Registrarse
        </button>
      </div>

      {
        error && (
          <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded-lg mb-6 text-sm">
            ¡Email o contraseña incorrectos!
          </div>
        )
      }

      <!-- Login Form -->
      <div id="login-form" class="hidden">
        <form
          method="POST"
          action="/api/auth/signin/credentials"
          class="space-y-5"
        >
          <input type="hidden" name="csrfToken" value={csrfToken} />

          <div class="space-y-1">
            <label
              for="login-email"
              class="block text-sm font-medium text-gray-700"
            >
              Correo<span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              id="login-email"
              name="email"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none"
              placeholder="nombre@email.com"
              required
            />
          </div>

          <div class="space-y-1">
            <label
              for="login-password"
              class="block text-sm font-medium text-gray-700"
            >
              Contraseña<span class="text-red-500">*</span>
            </label>
            <input
              type="password"
              id="login-password"
              name="password"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none"
              placeholder="••••••••••••"
              required
            />
          </div>

          <button
            type="submit"
            class="w-full bg-black text-white py-3 rounded-full font-medium hover:bg-gray-800 transition-all duration-200 mt-6"
          >
            Iniciar Sesión
          </button>
        </form>

        <div class="mt-6">
          <p class="text-xs text-center text-gray-500 mb-3">
            O inicia sesión con
          </p>
          <form method="POST" action="/api/auth/signin/google">
            <input type="hidden" name="csrfToken" value={csrfToken} />
            <button
              type="submit"
              class="w-full flex items-center justify-center gap-3 py-3 border border-gray-300 rounded-full font-medium text-sm text-gray-700 hover:bg-gray-50 transition-all duration-200"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                height="20"
                width="20"
                viewBox="0 0 48 48"
              >
                <path
                  fill="#FFC107"
                  d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039L38.804 8.841C34.522 4.908 29.563 2.5 24 2.5C11.318 2.5 2.5 11.318 2.5 24s8.818 21.5 21.5 21.5S45.5 36.682 45.5 24c0-1.542-.136-3.042-.389-4.417z"
                ></path>
                <path
                  fill="#FF3D00"
                  d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12.5 24 12.5c3.059 0 5.842 1.154 7.961 3.039L38.804 8.841C34.522 4.908 29.563 2.5 24 2.5C16.318 2.5 9.818 6.355 6.306 11.691z"
                ></path>
                <path
                  fill="#4CAF50"
                  d="M24 45.5c5.563 0 10.522-2.408 14.804-6.341L31.961 32.84c-2.119 1.883-4.902 3.039-7.961 3.039c-5.223 0-9.649-3.657-11.303-8.309l-6.571 4.819C9.818 39.145 16.318 45.5 24 45.5z"
                ></path>
                <path
                  fill="#1976D2"
                  d="M43.611 20.083H42V20H24v8h11.303c-.792 2.237-2.231 4.166-4.087 5.571l6.571 4.819C42.818 35.438 45.5 29.838 45.5 24c0-1.542-.136-3.042-.389-4.417z"
                ></path>
              </svg>
              <span>Continuar con Google</span>
            </button>
          </form>
        </div>
      </div>

      <!-- Register Form -->
      <div id="register-form">
        <form method="POST" action="/api/register" class="space-y-5">
          <div class="space-y-1">
            <label for="name" class="block text-sm font-medium text-gray-700">
              Nombre<span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none"
              placeholder="Nombre"
              required
            />
          </div>

          <div class="space-y-1">
            <label
              for="lastName"
              class="block text-sm font-medium text-gray-700"
            >
              Apellidos<span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="lastName"
              name="lastName"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none"
              placeholder="Apellidos"
              required
            />
          </div>

          <div class="space-y-1">
            <label
              for="register-email"
              class="block text-sm font-medium text-gray-700"
            >
              Correo<span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              id="register-email"
              name="email"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none"
              placeholder="Nombre@email.com"
              required
            />
          </div>

          <div class="space-y-1">
            <label
              for="register-password"
              class="block text-sm font-medium text-gray-700"
            >
              Contraseña<span class="text-red-500">*</span>
            </label>
            <input
              type="password"
              id="register-password"
              name="password"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none"
              placeholder="••••••••••••"
              required
            />
          </div>

          <div class="flex items-start gap-3 pt-2">
            <input
              type="checkbox"
              id="terms"
              name="terms"
              class="mt-1 h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded cursor-pointer"
              required
            />
            <label
              for="terms"
              class="text-sm text-gray-700 leading-tight cursor-pointer"
            >
              Leí y acepto <a href="#" class="text-blue-600 hover:underline"
                >términos y condiciones</a
              >
            </label>
          </div>

          <button
            type="submit"
            class="w-full bg-black text-white py-3 rounded-full font-medium hover:bg-gray-800 transition-all duration-200 mt-6"
          >
            Registrarse
          </button>
        </form>

        <p class="text-center mt-6">
          <a
            href="#"
            id="go-to-login"
            class="text-sm text-gray-600 hover:text-gray-900 underline"
          >
            Ya tengo cuenta
          </a>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  const loginForm = document.getElementById("login-form");
  const registerForm = document.getElementById("register-form");
  const showLoginBtn = document.getElementById("show-login-btn");
  const showRegisterBtn = document.getElementById("show-register-btn");
  const goToLoginLink = document.getElementById("go-to-login");

  function showLogin() {
    loginForm?.classList.remove("hidden");
    registerForm?.classList.add("hidden");

    // Update button styles
    showLoginBtn?.classList.add("bg-black", "text-white");
    showLoginBtn?.classList.remove("text-gray-700", "hover:bg-gray-50");

    showRegisterBtn?.classList.remove("bg-black", "text-white");
    showRegisterBtn?.classList.add("text-gray-700", "hover:bg-gray-50");
  }

  function showRegister() {
    loginForm?.classList.add("hidden");
    registerForm?.classList.remove("hidden");

    // Update button styles
    showRegisterBtn?.classList.add("bg-black", "text-white");
    showRegisterBtn?.classList.remove("text-gray-700", "hover:bg-gray-50");

    showLoginBtn?.classList.remove("bg-black", "text-white");
    showLoginBtn?.classList.add("text-gray-700", "hover:bg-gray-50");
  }

  // Por defecto, mostramos el formulario de registro (como en la imagen)
  showLogin();

  showLoginBtn?.addEventListener("click", showLogin);
  showRegisterBtn?.addEventListener("click", showRegister);
  goToLoginLink?.addEventListener("click", (e) => {
    e.preventDefault();
    showLogin();
  });
</script>
