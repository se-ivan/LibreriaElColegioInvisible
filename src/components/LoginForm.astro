---
import "../styles/global.css";

let csrfToken = "";

try {
  const response = await fetch(`${Astro.url.origin}/api/auth/csrf`, {
    headers: Astro.request.headers,
  });

  if (response.ok) {
    const json = await response.json();
    csrfToken = json.csrfToken;
  } else {
    console.error("Server-side CSRF fetch failed with status:", response.status);
  }
} catch (error) {
  console.error("Could not connect to the API to get CSRF token on server.", error);
}

const error = Astro.url.searchParams.get("error");
---

<div
  class="min-h-screen bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center p-4"
>
  <div
    class="w-full max-w-5xl flex flex-col md:flex-row rounded-2xl shadow-2xl overflow-hidden bg-white"
  >
    <div
      class="w-full md:w-1/2 aspect-square flex flex-col items-center rounded-l-xl justify-center p-12 bg-[#281E67] text-white text-center relative overflow-hidden"
    >
      <img
        src="/logoColegio.jpg"
        alt="Logo"
        class="aspect-square w-full max-h-[415px]"
      />
    </div>

    <div class="w-full md:w-1/2 bg-white p-8 md:p-12">
      <div class="flex mb-8 gap-4">
        <button
          id="show-login-btn"
          class="flex-1 py-3 text-sm font-medium text-center rounded-full transition-all duration-200 border border-transparent hover:bg-gray-50"
        >
          Iniciar sesión
        </button>
        <button
          id="show-register-btn"
          class="flex-1 py-3 text-sm font-medium text-center rounded-full bg-black text-white transition-all duration-200 hover:bg-gray-800"
        >
          Registrarse
        </button>
      </div>

      {
        error && (
          <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded-lg mb-6 text-sm">
            ¡Email o contraseña incorrectos!
          </div>
        )
      }

      <div id="login-form" class="hidden">
        <div
          id="login-error"
          class="hidden bg-red-50 border border-red-200 text-red-700 p-3 rounded-lg mb-6 text-sm"
        >
        </div>

        <form
          method="POST"
          action="/api/auth/callback/credentials"
          class="space-y-5"
          novalidate
        >
          <input type="hidden" name="csrfToken" value={csrfToken} />

          <div class="space-y-1">
            <label
              for="login-email"
              class="block text-sm font-medium text-gray-700"
              >Correo<span class="text-red-500">*</span></label
            >
            <input
              type="email"
              id="login-email"
              name="email"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none"
              placeholder="nombre@email.com"
            />
          </div>
          <div class="space-y-1">
            <label
              for="login-password"
              class="block text-sm font-medium text-gray-700"
              >Contraseña<span class="text-red-500">*</span></label
            >
            <input
              type="password"
              id="login-password"
              name="password"
              required
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none"
              placeholder="••••••••"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-black text-white py-3 rounded-full font-medium mt-6 hover:bg-gray-800 transition-all"
            >Iniciar Sesión</button
          >
        </form>

        <div class="mt-6">
          <p class="text-xs text-center text-gray-500 mb-3">
            O inicia sesión con
          </p>

          <form id="google-form" method="POST" action="/api/auth/signin/google">
            <input
              type="hidden"
              id="csrfTokenInputGoogle"
              name="csrfToken"
              value={csrfToken}
            />
            <button
              type="submit"
              class="w-full flex items-center justify-center gap-3 py-3 border border-gray-300 rounded-full hover:bg-gray-50 transition-all"
            >
              <span>Continuar con Google</span>
            </button>
          </form>
        </div>
      </div>

      <div id="register-form">
        <form method="POST" action="/api/register" class="space-y-5">
          <div class="space-y-1">
            <label for="name" class="block text-sm font-medium text-gray-700">
              Nombre<span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none"
              placeholder="Nombre"
              required
            />
          </div>

          <div class="space-y-1">
            <label
              for="lastName"
              class="block text-sm font-medium text-gray-700"
            >
              Apellidos<span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="lastName"
              name="lastName"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none"
              placeholder="Apellidos"
              required
            />
          </div>

          <div class="space-y-1">
            <label
              for="register-email"
              class="block text-sm font-medium text-gray-700"
            >
              Correo<span class="text-red-500">*</span>
            </label>
            <input
              type="email"
              id="register-email"
              name="email"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none"
              placeholder="Nombre@email.com"
              required
            />
          </div>

          <div class="space-y-1">
            <label
              for="register-password"
              class="block text-sm font-medium text-gray-700"
            >
              Contraseña<span class="text-red-500">*</span>
            </label>
            <input
              type="password"
              id="register-password"
              name="password"
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all outline-none"
              placeholder="••••••••••••"
              required
            />
          </div>

          <div class="flex items-start gap-3 pt-2">
            <input
              type="checkbox"
              id="terms"
              name="terms"
              class="mt-1 h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded cursor-pointer"
              required
            />
            <label
              for="terms"
              class="text-sm text-gray-700 leading-tight cursor-pointer"
            >
              Leí y acepto <a href="#" class="text-blue-600 hover:underline"
                >términos y condiciones</a
              >
            </label>
          </div>

          <button
            type="submit"
            class="w-full bg-black text-white py-3 rounded-full font-medium hover:bg-gray-800 transition-all duration-200 mt-6"
          >
            Registrarse
          </button>
        </form>

        <p class="text-center mt-6">
          <a
            href="#"
            id="go-to-login"
            class="text-sm text-gray-600 hover:text-gray-900 underline"
          >
            Ya tengo cuenta
          </a>
        </p>
      </div>
    </div>
  </div>
</div>

<script type="module">
  const form = document.getElementById("login-form-el");
  const errorBox = document.getElementById("login-error");
  const csrfInput = document.getElementById("csrfTokenInput");
  const csrfInputGoogle = document.getElementById("csrfTokenInputGoogle");

  async function fetchCsrf() {
    try {
      const res = await fetch("/api/auth/csrf", {
        method: "GET",
        credentials: "same-origin",
      });
      if (!res.ok) throw new Error("No se obtuvo CSRF");
      const json = await res.json();
      const token = json?.csrfToken ?? "";

      if (csrfInput) csrfInput.value = token;
      if (csrfInputGoogle) csrfInputGoogle.value = token;
    } catch (err) {
      console.warn("Error en el CSRF del Cliente:", err);
    }
  }

  fetchCsrf();


  const showLoginBtn = document.getElementById("show-login-btn");
  const showRegisterBtn = document.getElementById("show-register-btn");
  const loginForm = document.getElementById("login-form");
  const registerForm = document.getElementById("register-form");
  const goToLoginLink = document.getElementById("go-to-login");

  function showLogin() {
    loginForm.classList.remove("hidden");
    registerForm.classList.add("hidden");
    showLoginBtn.classList.add("bg-black", "text-white");
    showRegisterBtn.classList.remove("bg-black", "text-white");
  }

  function showRegister() {
    loginForm.classList.add("hidden");
    registerForm.classList.remove("hidden");
    showRegisterBtn.classList.add("bg-black", "text-white");
    showLoginBtn.classList.remove("bg-black", "text-white");
  }

  showLoginBtn.addEventListener("click", showLogin);
  showRegisterBtn.addEventListener("click", showRegister);
  goToLoginLink.addEventListener("click", (e) => {
    e.preventDefault();
    showLogin();
  });

  // Estado inicial al cargar la página
  showLogin();
</script>
