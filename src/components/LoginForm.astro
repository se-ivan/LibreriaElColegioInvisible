---
import "../styles/global.css";

// ... (Tu lógica de CSRF existente se mantiene igual) ...
let csrfToken = "";
try {
  const response = await fetch(`${Astro.url.origin}/api/auth/csrf`, {
    headers: Astro.request.headers,
  });
  if (response.ok) {
    const json = await response.json();
    csrfToken = json.csrfToken;
  }
} catch (error) { console.error(error); }

// Capturamos parámetros de error y de éxito
const error = Astro.url.searchParams.get("error");
const registered = Astro.url.searchParams.get("registered"); // <--- NUEVO
---

<div class="min-h-screen bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center p-4 relative">
  
  <div 
    id="success-modal" 
    class={`fixed inset-0 bg-black/50 z-50 flex items-center justify-center backdrop-blur-sm transition-opacity duration-300 ${registered === 'true' ? 'opacity-100' : 'hidden opacity-0'}`}
  >
    <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-sm w-full text-center transform transition-transform duration-300 scale-100">
      <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-green-100 mb-6">
        <svg class="h-10 w-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <h3 class="text-2xl font-bold text-gray-900 mb-2">¡Registro Exitoso!</h3>
      <p class="text-gray-500 mb-8">Tu cuenta ha sido creada. Por favor inicia sesión.</p>
      <button id="close-modal-btn" class="w-full bg-black text-white py-3 rounded-full font-medium hover:bg-gray-800 transition-all shadow-lg hover:shadow-xl">
        Entendido
      </button>
    </div>
  </div>

  <div class="w-full max-w-5xl flex flex-col md:flex-row rounded-2xl shadow-2xl overflow-hidden bg-white">
    <div class="w-full md:w-1/2 aspect-square flex flex-col items-center rounded-l-xl justify-center p-12 bg-[#281E67] text-white text-center relative overflow-hidden">
        <img src="/logoColegio.jpg" alt="Logo" class="aspect-square w-full max-h-[415px]" />
    </div>

    <div class="w-full md:w-1/2 bg-white p-8 md:p-12">
      <div class="flex mb-8 gap-4">
        <button id="show-login-btn" class="flex-1 py-3 text-sm font-medium text-center rounded-full transition-all duration-200 border border-transparent hover:bg-gray-50">
          Iniciar sesión
        </button>
        <button id="show-register-btn" class="flex-1 py-3 text-sm font-medium text-center rounded-full bg-black text-white transition-all duration-200 hover:bg-gray-800">
          Registrarse
        </button>
      </div>

      {error && (
        <div class="bg-red-50 border border-red-200 text-red-700 p-3 rounded-lg mb-6 text-sm">
          {error === 'CredentialsSignin' ? 'Credenciales incorrectas' : 'Ocurrió un error. Inténtalo de nuevo.'}
        </div>
      )}

      <div id="login-form" class="hidden">
        <form method="POST" action="/api/auth/callback/credentials" class="space-y-5">
           <input type="hidden" name="csrfToken" value={csrfToken} />
           <div class="space-y-1">
            <label for="login-email" class="block text-sm font-medium text-gray-700">Correo<span class="text-red-500">*</span></label>
            <input type="email" id="login-email" name="email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500" placeholder="nombre@email.com" />
          </div>
          <div class="space-y-1">
            <label for="login-password" class="block text-sm font-medium text-gray-700">Contraseña<span class="text-red-500">*</span></label>
            <input type="password" id="login-password" name="password" required class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500" placeholder="••••••••" />
          </div>
          <button type="submit" class="w-full bg-black text-white py-3 rounded-full font-medium mt-6 hover:bg-gray-800 transition-all">Iniciar Sesión</button>
        </form>
        </div>

      <div id="register-form">
        <form method="POST" action="/api/register" class="space-y-5">
          <input type="hidden" name="csrfToken" value={csrfToken} />
          
          <div class="space-y-1">
            <label for="name" class="block text-sm font-medium text-gray-700">Nombre<span class="text-red-500">*</span></label>
            <input type="text" name="name" required class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500" placeholder="Nombre" />
          </div>

          <div class="space-y-1">
            <label for="lastName" class="block text-sm font-medium text-gray-700">Apellidos<span class="text-red-500">*</span></label>
            <input type="text" name="lastName" required class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500" placeholder="Apellidos" />
          </div>

          <div class="space-y-1">
            <label for="register-email" class="block text-sm font-medium text-gray-700">Correo<span class="text-red-500">*</span></label>
            <input type="email" name="email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500" placeholder="nombre@email.com" />
          </div>

          <div class="space-y-1">
            <label for="register-password" class="block text-sm font-medium text-gray-700">Contraseña<span class="text-red-500">*</span></label>
            <input type="password" name="password" required class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-blue-500" placeholder="••••••••••••" />
          </div>

          <div class="flex items-start gap-3 pt-2">
            <input type="checkbox" id="terms" name="terms" required class="mt-1 h-4 w-4 text-blue-600 border-gray-300 rounded" />
            <label for="terms" class="text-sm text-gray-700">Acepto términos y condiciones</label>
          </div>

          <button type="submit" class="w-full bg-black text-white py-3 rounded-full font-medium hover:bg-gray-800 transition-all mt-6">
            Registrarse
          </button>
        </form>

        <p class="text-center mt-6">
          <a href="#" id="go-to-login" class="text-sm text-gray-600 hover:text-gray-900 underline">Ya tengo cuenta</a>
        </p>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ registered }}>
  // Scripts para manejo de tabs
  const showLoginBtn = document.getElementById("show-login-btn");
  const showRegisterBtn = document.getElementById("show-register-btn");
  const loginForm = document.getElementById("login-form");
  const registerForm = document.getElementById("register-form");
  const goToLoginLink = document.getElementById("go-to-login");
  
  // Scripts del Modal
  const modal = document.getElementById("success-modal");
  const closeModalBtn = document.getElementById("close-modal-btn");

  function showLogin() {
    loginForm?.classList.remove("hidden");
    registerForm?.classList.add("hidden");
    showLoginBtn?.classList.add("bg-black", "text-white");
    showRegisterBtn?.classList.remove("bg-black", "text-white");
  }

  function showRegister() {
    loginForm?.classList.add("hidden");
    registerForm?.classList.remove("hidden");
    showRegisterBtn?.classList.add("bg-black", "text-white");
    showLoginBtn?.classList.remove("bg-black", "text-white");
  }

  showLoginBtn?.addEventListener("click", showLogin);
  showRegisterBtn?.addEventListener("click", showRegister);
  goToLoginLink?.addEventListener("click", (e) => {
    e.preventDefault();
    showLogin();
  });

  // Lógica de ESTADO INICIAL basada en URL
  // Si viene con ?registered=true, mostramos el login y el modal
  if (registered === 'true') {
    showLogin();
    // Limpiar la URL para que al recargar no salga el modal de nuevo (opcional)
    const newUrl = window.location.protocol + "//" + window.location.host + window.location.pathname;
    window.history.replaceState({path:newUrl},'',newUrl);
  } else {
    // Si no hay parámetro, mostramos el login por defecto
    showLogin();
  }

  // Cerrar modal
  closeModalBtn?.addEventListener("click", () => {
    modal.classList.add("opacity-0");
    setTimeout(() => {
        modal.classList.add("hidden");
    }, 300);
  });
</script>