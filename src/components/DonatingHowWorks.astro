---
const {title, description} = Astro.props;
---

<div class="text-black px-6 py-4 text-center w-90 h-70 flex flex-col items-center justify-center rounded-2xl bg-[#F5F5F5] border-2 border-[#F1C86E]/50">
    <div class="rounded-full h-20 w-20 bg-[#E1EAF7] flex items-center justify-center mb-6">
        <slot />
    </div>
    
    <div class="flex flex-col gap-6 mb-2">
        <h3 class="text-2xl font-medium">{title}</h3>
        <p class="text-[#617992]">{description}</p>
    </div>
</div>