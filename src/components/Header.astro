---
import "../styles/global.css";
---
<header class="sticky z-50 top-0 left-0 h-16 w-full flex flex-row items-center justify-between bg-[#00305d] text-white font-medium text-sm px-25">
    <div class="flex flex-row items-center justify-center gap-4">
        <img src="/logoHeader.svg" alt="Logo" class="h-12 w-12"/>
        <span class="text-xl font-semibold">El Colegio Invisible</span>
    </div>
    <nav>
        <ul class="flex flex-row justify-center items-center gap-6">
            <li class="hover:scale-120 transition-all duration-300"><a href="/">Autores</a></li>
            <li class="hover:scale-120 transition-all duration-300"><a href="/BookList">Libros</a></li>
            <li class="hover:scale-120 transition-all duration-300"><a href="/">Libros del Mes</a></li>
            <li class="hover:scale-120 transition-all duration-300"><a href="/noticias-eventos">Noticias</a></li>
            <li class="hover:scale-120 transition-all duration-300"><a href="/">Servicios</a></li>
            <li class="hover:scale-120 transition-all duration-300"><a href="/">Eventos</a></li>
            <li class="hover:scale-120 transition-all duration-300"><a href="/donaciones">Donaciones</a></li>
            <li class="hover:scale-120 transition-all duration-300"><a href="/">Colaboradores</a></li>
            <li class="hover:scale-120 transition-all duration-300"><a href="/">Contacto</a></li>
        </ul>
    </nav>
    <input class="rounded-md h-9 w-60 border-2 border-[#C6DBEA] bg-white text-[#7C7C7C] px-2" placeholder="Buscar..." type="text">
</header>