<script>
  // 1. Definición de Interfaces para TypeScript
  interface Author {
    name: string;
  }

  interface Book {
    id: number | string;
    title: string;
    image?: string | null;
    author?: Author | null;
  }

  interface ApiResponse {
    books: Book[];
    total?: number;
    // Agrega otros campos si tu API los devuelve
  }

  // 2. Lógica del Menú Hamburguesa
  const btn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu') as HTMLDivElement | null;

  if(btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }

  // 3. Lógica de Búsqueda
  function setupSearch(inputId: string, resultsId: string) {
    // Aserción de tipos para elementos del DOM
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    const resultsContainer = document.getElementById(resultsId) as HTMLDivElement | null;

    if (!input || !resultsContainer) return;

    let debounceTimer: ReturnType<typeof setTimeout>;

    input.addEventListener('input', (e: Event) => {
      // Casteamos el target para acceder a .value
      const target = e.target as HTMLInputElement;
      const query = target.value.trim();

      clearTimeout(debounceTimer);

      if (query.length < 2) {
        resultsContainer.innerHTML = '';
        resultsContainer.classList.add('hidden');
        return;
      }

      debounceTimer = setTimeout(async () => {
        try {
          const res = await fetch(`/api/books?q=${encodeURIComponent(query)}`);
          if (!res.ok) throw new Error('Error fetching');
          
          // Tipamos la respuesta
          const responseData = await res.json() as ApiResponse | Book[];
          
          // Manejamos si la API devuelve array directo o un objeto { books: [...] }
          let books: Book[] = [];
          if (Array.isArray(responseData)) {
            books = responseData;
          } else if (responseData.books) {
            books = responseData.books;
          }

          if (books.length > 0) {
            resultsContainer.innerHTML = books.map((book) => `
              <a href="/libros/${book.id}" class="block px-4 py-3 hover:bg-gray-100 border-b border-gray-100 last:border-0 transition-colors flex items-center gap-3">
                 ${book.image ? `<img src="${book.image}" class="w-8 h-10 object-cover rounded" />` : ''}
                 <div>
                    <p class="font-bold text-sm text-[#00305d]">${book.title}</p>
                    <p class="text-xs text-gray-500">${book.author ? book.author.name : 'Autor desconocido'}</p>
                 </div>
              </a>
            `).join('');
            
            resultsContainer.innerHTML += `
                <a href="/BookList?search=${query}" class="block px-4 py-2 text-xs text-center text-blue-600 font-bold bg-gray-50 hover:bg-gray-100">
                    Ver todos los resultados
                </a>
            `;
            resultsContainer.classList.remove('hidden');
          } else {
            resultsContainer.innerHTML = `<div class="px-4 py-3 text-sm text-gray-500">No se encontraron libros.</div>`;
            resultsContainer.classList.remove('hidden');
          }

        } catch (error) {
          console.error(error);
        }
      }, 300);
    });

    // Evento de click fuera para cerrar el dropdown
    document.addEventListener('click', (e: MouseEvent) => {
        const target = e.target as Node;
        if (!input.contains(target) && !resultsContainer.contains(target)) {
            resultsContainer.classList.add('hidden');
        }
    });
  }

  // Inicializar
  setupSearch('search-input-desktop', 'search-results-desktop');
  setupSearch('search-input-mobile', 'search-results-mobile');

</script>