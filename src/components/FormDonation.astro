---
import InputText from "./InputText.astro";
---

<article class="rounded-3xl py-7 px-13 bg-white w-full max-w-250">
    <div class="flex flex-col gap-4 text-center mb-8">
        <h4 class="text-xl md:text-3xl font-medium">Formulario de Donacion</h4>
        <p class="text-texto-claro text-sm sm:text-base md:text-xl">
            Completa este formulario y nos pondremos en contacto contigo
        </p>
    </div>

    <form action="" class="w-full">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-7 mb-8">
            <InputText
                label="Nombre Completo*"
                id="fullName"
                name="fullName"
                placeholder="Nombre"
            />
            <InputText
                label="Correo Electronico*"
                id="email"
                name="email"
                placeholder="ejemplo@gmail.com"
            />
            <InputText
                label="Telefono*"
                id="phone"
                name="phone"
                placeholder="443 489 5891"
            />
            <InputText
                label="Cantidad Aproximada de Libros*"
                id="address"
                name="address"
                placeholder="10"
            />
        </div>

        <fieldset class="mb-8">
            <legend class="md:text-lg font-medium mb-2">Tipo de Donacion*</legend>

            <div>
                <input
                    type="radio"
                    id="sucursal"
                    name="radio"
                    value="sucursal"
                />
                <label for="sucursal" class="text-sm md:text-lg font-light"
                    >Llevare libros a sucursal</label
                >
            </div>

            <div>
                <input
                    type="radio"
                    id="domicilio"
                    name="radio"
                    value="domicilio"
                />
                <label for="domicilio" class="text-sm md:text-lg font-light"
                    >Solicito recolección a domicilio (más de 20 libros)</label
                >
            </div>
        </fieldset>

        <div class="flex flex-col gap-2 mb-4">
            <label class="md:text-lg font-medium" for="direccion"
                >Dirección (si solicitas recolección)</label
            >
            <input
                id="direccion"
                name="direccion"
                type="text"
                placeholder="Calle, número, colonia, ciudad"
                class="w-full h-10 px-3 py-2 max-md:text-sm border border-[#E8F1F7] rounded-lg focus:outline-none focus:ring-2 focus:ring-texto-resaltado focus:border-transparent"
            />
        </div>

        <div class="flex flex-col gap-2">
            <label class="md:text-lg font-medium" for="adicional"
                >Mensaje Adicional</label
            >
            <textarea
                id="adicional"
                name="adicional"
                placeholder="Cuéntanos sobre los libros que deseas donar ..."
                class="w-full h-25 px-3 py-2 max-md:text-sm border border-[#E8F1F7] rounded-lg focus:outline-none focus:ring-2 focus:ring-texto-resaltado focus:border-transparent"
            ></textarea>
        </div>

        <button
            class="w-full max-md:max-w-80 m-auto h-12 bg-[#0096A2] text-white rounded-lg md:text-xl mt-8 flex flex-row gap-2 items-center justify-center hover:bg-[#007f87] transition-colors duration-300"
        >
            <span
                ><svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#FFFFFF"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="icon icon-tabler icons-tabler-outline icon-tabler-heart hidden md:inline-block"
                    ><path stroke="none" d="M0 0h24v24H0z" fill="none"
                    ></path><path
                        d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572"
                    ></path></svg
                ></span
            >Enviar Solicitud de Donación</button
        >
    </form>
</article>
