---
const {placeholder, label, id, name} = Astro.props;
---

<div class="flex flex-col gap-2">
    <label class="text-lg font-medium" for={id}>{label}</label>
    <input
        id={id}
        name={name}
        type="text"
        placeholder={placeholder}
        class="w-full h-10 px-3 py-2 border border-[#E8F1F7] rounded-lg focus:outline-none focus:ring-2 focus:ring-[#00305D] focus:border-transparent"
        required
    />
</div>