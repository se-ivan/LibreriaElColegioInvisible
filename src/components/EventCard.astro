---
interface Props {
    title: string;
    description: string;
    date: string;
    location: string;
    price: number;
    image: string;
    id: number;
}
const { title, description, date, location, price, image, id } = Astro.props;
---

<div
    class="bg-[#002B5B] p-4 rounded-lg text-white flex flex-col gap-2 w-80 mx-auto transform transition duration-500 hover:scale-105"
>
    <div
        class="w-full h-40 rounded-lg overflow-hidden bg-gray-300 relative group"
    >
        {
            image ? (
                <img
                    src={image}
                    alt={title}
                    class="w-full h-full object-cover transition duration-300 group-hover:brightness-75"
                />
            ) : (
                <div class="w-full h-full flex items-center justify-center text-gray-500 text-xs bg-gray-200">
                    Sin imagen
                </div>
            )
        }
        <div
            class="absolute top-2 right-2 bg-yellow-500 text-slate-900 text-xs font-bold px-2 py-1 rounded shadow"
        >
            {price === 0 ? "Gratis" : `$${price}`}
        </div>
    </div>

    <h3 class="font-bold text-lg leading-tight mt-1">{title}</h3>

    <div class="flex items-center text-xs text-gray-300 gap-1">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 text-cyan-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
        </svg>
        <span>{date}</span>
    </div>

    <div class="flex items-center text-xs text-gray-300 gap-1">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-4 w-4 text-cyan-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span>{location}</span>
    </div>

    <p class="text-xs text-gray-400 line-clamp-2 mt-1">
        {description}
    </p>

    <!-- Placeholder for future functionality, maybe navigate to detail -->
    <!--
    <a href={`/eventos/${id}`} class="text-xs mt-3 text-cyan-400 hover:text-cyan-300 font-semibold self-start uppercase tracking-wider">
        Ver detalles
    </a>
    -->
</div>
