---
const { number, description } = Astro.props;
---

<div
    class="min-h-45 w-90 max-h-50 flex flex-col items-center justify-center rounded-2xl bg-[#ECF5FC] border-2 border-azul-blanco "
>
    <slot />
    <div class="text-center px-4">
        <h2 class="text-4xl font-medium mb-2 text-texto-resaltado">{number}</h2>
        <p class="text-texto-claro">{description}</p>
    </div>
</div>
