---
const {title, autor, votes, description, rating, bookId} = Astro.props;
import StarRating from "./StarRating.astro";
---

<article
    class="w-full max-w-375 bg-[#F9FCFF] border border-[#BFD6EC] rounded-2xl mt-6 grid grid-cols-1 lg:grid-cols-2 place-items-center px-10 py-12"
>   
    <div class="hover:scale-105 transition-all duration-300">
        <img
            src="/images/home/descubrimientodelmes.png"
            alt="Imagen del Libro del Mes"
            class="rounded-xl"
        />
    </div>

    <div class="font-medium">
        <p class="text-xl md:text-3xl mb-3 mt-3">{title}</p>
        <p class="text-[#5B748E] md:text-lg">por {autor}</p>

        <div class="mt-4 flex flex-row">
            <StarRating score={rating} />
            <p class="ml-4">{rating}</p>
        </div>

        <p class="text-[#5B748E] md:min-w-100 text-sm md:text-base mt-6">
            {description}
        </p>

        <div class="mt-6">
            <div class="w-full flex flex-row justify-between">
                <p class="text-sm">Total de Votos</p>
                <p class="text-[#0056A4] text-sm">{votes}</p>
            </div>
            <div class="h-3 w-full bg-[#BED6ED] rounded-md mt-2">
                <div class="h-3 w-20 bg-[#0056A4] rounded-md"></div>
            </div>
        </div>

        <div class="flex flex-row justify-center gap-5 mt-6">
            <a  href={`/books/${bookId}`}
                class="text-white text-sm md:text-lg w-full flex justify-center items-center max-w-125 h-10 bg-[#01ACA5] rounded-lg hover:bg-[#0f8b87] transition-colors duration-300 hover:cursor-pointer"
                >Ver Detalles del Libro</a
            >
        </div>
    </div>
</article>
