---

<footer class="bg-gray-50 border-t border-gray-200 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      <!-- Librería Fantástica -->
      <div>
        <h3 class="font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-teal-600" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z" />
          </svg>
          Librería Fantástica
        </h3>
        <p class="text-sm text-gray-600 leading-relaxed">
          La aventura empieza en nuestra. Más que libros: historias que transforman vidas.
        </p>
      </div>

      <!-- Enlaces Rápidos -->
      <div>
        <h3 class="font-semibold text-gray-900 mb-4">Enlaces Rápidos</h3>
        <ul class="space-y-2">
          <li><a href="/autores" class="text-sm text-gray-600 hover:text-teal-600 transition-colors">Autores</a></li>
          <li><a href="/catalogo" class="text-sm text-gray-600 hover:text-teal-600 transition-colors">Catálogo</a></li>
          <li><a href="/libro-del-mes" class="text-sm text-gray-600 hover:text-teal-600 transition-colors">Libro del Mes</a></li>
          <li><a href="/eventos" class="text-sm text-gray-600 hover:text-teal-600 transition-colors">Eventos</a></li>
        </ul>
      </div>

      <!-- Servicios -->
      <div>
        <h3 class="font-semibold text-gray-900 mb-4">Servicios</h3>
        <ul class="space-y-2">
          <li><a href="/encuentros" class="text-sm text-gray-600 hover:text-teal-600 transition-colors">Encuentros</a></li>
          <li><a href="/busqueda-de-libros" class="text-sm text-gray-600 hover:text-teal-600 transition-colors">Búsqueda de Libros</a></li>
          <li><a href="/impresion" class="text-sm text-gray-600 hover:text-teal-600 transition-colors">Impresión</a></li>
          <li><a href="/publica-con-nosotros" class="text-sm text-gray-600 hover:text-teal-600 transition-colors">Publica con Nosotros</a></li>
        </ul>
      </div>

      <!-- Contacto -->
      <div>
        <h3 class="font-semibold text-gray-900 mb-4">Contacto</h3>
        <ul class="space-y-2">
          <li class="flex items-center gap-2 text-sm text-gray-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <a href="mailto:info@colegioinvisible.com" class="hover:text-teal-600 transition-colors">info@colegioinvisible.com</a>
          </li>
          <li class="flex items-center gap-2 text-sm text-gray-600">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
