---
interface Props {
  name: string;
  nationality: string;
  genre: string;
  imageUrl: string;
  totalBooks: number;
}

const { name, nationality, genre, imageUrl, totalBooks } = Astro.props;
---

<div class="bg-[#f9fcfe] rounded-lg shadow-md overflow-hidden transition duration-300 ease-in-out hover:shadow-xl hover:scale-[1.02]">
  <div class="h-60 overflow-hidden">
    <img
      src={imageUrl}
      alt={`Foto de ${name}`}
      class="w-full h-full object-cover"
    />
  </div>
  <div class="p-4">
    <h3 class="text-xl font-bold text-gray-900 mb-1">{name}</h3>
    <div class="flex flex-wrap gap-2 text-sm mb-2">
      <span class="bg-blue-100 text-[#354a6a] font-medium px-2 py-0.5 rounded-full">
        {nationality}
      </span>
      <span class="bg-white  text-black border-2 border-blue-100 font-medium px-2 py-0.5 rounded-full">
        {genre}
      </span>
    </div>
    <div class="mb-2">
      <span class="text-gray-400 font-light rounded-full text-sm">
        Libros publicados: {totalBooks}
      </span>
    </div>
    <a href={`/autores/${name.toLowerCase().replace(/\s+/g, '-')}`} 
       class="text-black hover:text-[#007bff] font-semibold text-sm flex items-center transition duration-300">
      Ver Perfil
      <svg class="ml-1 w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>
</div>